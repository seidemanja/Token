# Copy to .env for local work. Do not commit .env.

NETWORK=local
LOCAL_RPC_URL=http://127.0.0.1:8545
LOCAL_WSS_URL=ws://127.0.0.1:8545
LOCAL_STATE_FILE=sim/.reward_state_local.json

# Local-only development key. For a Hardhat node, use one of the printed dev keys.
# Never use or commit a key that controls real funds or roles.
PRIVATE_KEY=

# Filled in after local deployments.
LOCAL_UNISWAP_V3_FACTORY=
LOCAL_UNISWAP_V3_POSITION_MANAGER=
LOCAL_WETH_ADDRESS=
LOCAL_TOKEN_ADDRESS=
LOCAL_JSTVIP_ADDRESS=
LOCAL_UNISWAP_V3_POOL_ADDRESS=
LOCAL_POOL_TOKEN0_ADDRESS=
LOCAL_POOL_TOKEN1_ADDRESS=

# NFT deployment/controller settings.
JSTVIP_ADMIN=
JSTVIP_MINTER=
COHORT_SALT=local-dev-change-me
COHORT_ELIGIBLE_PERCENT=50
THRESHOLD_TOKENS=0.75
SIM_START_REWARD_CONTROLLER=true

# Sepolia values are optional and should only be used for low-volume validation.
SEPOLIA_RPC_URL=
SEPOLIA_WSS_URL=
SEPOLIA_TOKEN_ADDRESS=
SEPOLIA_JSTVIP_ADDRESS=
SEPOLIA_UNISWAP_V3_POOL_ADDRESS=
SEPOLIA_POOL_TOKEN0_ADDRESS=
SEPOLIA_POOL_TOKEN1_ADDRESS=
