# Employer/demo simulation preset.
# Based on the surviving March 23, 2026 45-day run manifest.
# Source this after your local .env so deployment-specific values stay local.
# Contains only safe simulation knobs; no addresses, RPC keys, private keys, or salts.

# Population scale used for the larger 45-day demo-style runs.
SIM_NUM_AGENTS=30
SIM_MAX_AGENTS=1200
SIM_ENTRY_LAMBDA_BASE=2.2
SIM_CHURN_PROB_BASE=0.0028

# NFT incentive experiment settings.
COHORT_ELIGIBLE_PERCENT=50
THRESHOLD_TOKENS=0.75
SIM_START_REWARD_CONTROLLER=true

# Launch/regime model: forced initial hype, then bear; rare later hype re-entry.
SIM_HYPE_INITIAL_MIN_DAYS=12
SIM_HYPE_INITIAL_MAX_DAYS=18
SIM_HYPE_EXIT_TO_BULL_PROB=0.0
SIM_HYPE_REENTRY_PROB=0.01
SIM_REGIME_BULL_PERSIST=0.82
SIM_REGIME_BEAR_PERSIST=0.78

# Moderately choppier but still professional-looking market dynamics.
SIM_SENTIMENT_ALPHA=0.35
SIM_FAIR_SIGMA=0.013
SIM_FLOW_SIGMA=0.60
SIM_FAIR_REVERSION=0.07
